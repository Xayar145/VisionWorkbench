<Window x:Class="VisionWorkbench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="视觉工作台" Width="1440" Height="920" MinWidth="1120" MinHeight="740" Background="#F3F5FA" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#24324B">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="250"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left" Margin="0,0,28,0"><TextBlock Text="视觉工作台" FontSize="21" FontWeight="Bold"/><TextBlock Text="视觉流程 · HALCON + OpenCV" Foreground="#7E899D" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel x:Name="ProjectActions" Orientation="Horizontal">
                    <Button Content="打开图像" Click="OpenImage_Click"/><Button Content="示例" Click="Demo_Click"/>
                    <Button Content="打开方案" Click="OpenProject_Click"/><Button Content="保存" Click="Save_Click"/>
                    <Button x:Name="RunButton" Content="▶ 运行" Click="Run_Click" Background="#4768F5" Foreground="White"/>
                    <Button Content="批量" Click="Batch_Click"/>
                </StackPanel>
                <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"><TextBlock Text="检测流程" FontWeight="Bold" FontSize="16"/><TextBlock Text="按顺序执行，选择工具调整参数" Foreground="#8A94A6" Margin="0,5,0,15"/>
                        <ComboBox x:Name="ToolPicker" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                        <Button x:Name="AddButton" Content="＋ 添加工具" Click="Add_Click" Margin="0,0,0,12"/>
                    </StackPanel>
                    <StackPanel x:Name="StepActions" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="↑" Click="Up_Click"/><Button Content="↓" Click="Down_Click"/><Button Content="删除" Click="Remove_Click"/></StackPanel>
                    <ListBox x:Name="StepList" BorderThickness="0" Background="Transparent" SelectionChanged="StepList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Enabled}" Click="Enabled_Changed" VerticalAlignment="Top" Margin="0,3,9,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Foreground="#8A94A6" FontSize="11" Margin="0,4,0,0"><Run Text="{Binding Backend}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="#182232" CornerRadius="10" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="15,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ImageInfo" Text="图像预览" Foreground="#CDD6E7" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="DrawRoi" Content="绘制 ROI" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/><Button Content="适应" Click="Fit_Click" Padding="9,4"/><Button Content="1:1" Click="Actual_Click" Padding="9,4"/></StackPanel></Grid>
                    <Grid><TextBlock x:Name="EmptyImage" Text="打开图像，或加载示例开始检测" Foreground="#8997B0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer x:Name="ImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Image_MouseWheel" SizeChanged="ImageScroller_SizeChanged">
                            <Grid x:Name="ImageSurface" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" MouseLeftButtonDown="Image_Down" MouseMove="Image_Move" MouseLeftButtonUp="Image_Up">
                                <Grid.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
                                <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="10">
                <TabControl BorderThickness="0" Background="White">
                    <TabItem Header="工具参数"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterPanel" Margin="8,15,8,5"><TextBlock Text="选择左侧工具查看参数" Foreground="#8A94A6"/></StackPanel></ScrollViewer></TabItem>
                    <TabItem Header="AI 助手"><Grid Margin="5,10,5,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><DockPanel><Button Content="连接设置" Click="Settings_Click" DockPanel.Dock="Right" Margin="0"/><Button Content="清空" Click="ClearChat_Click" DockPanel.Dock="Right"/><TextBlock Text="工具调用" VerticalAlignment="Center" Foreground="#8A94A6"/></DockPanel>
                            <Expander Header="本机工具接口（Harness）" Margin="0,10,0,0"><StackPanel Margin="0,8,0,4"><TextBlock Text="接口地址" FontSize="11" Foreground="#8A94A6"/><TextBox x:Name="HarnessAddress" IsReadOnly="True" Margin="0,3,0,8"/><TextBlock Text="本次会话文件（含本机访问密钥）" FontSize="11" Foreground="#8A94A6"/><TextBox x:Name="HarnessSession" IsReadOnly="True" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Expander>
                        </StackPanel>
                        <ScrollViewer x:Name="ChatScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10"><StackPanel x:Name="ChatMessages"><TextBlock Text="可以让 AI 查看流程、修改参数、运行检测并解释结果。请先配置模型连接。" TextWrapping="Wrap" Foreground="#7E899D"/></StackPanel></ScrollViewer>
                        <TextBox x:Name="ChatInput" Grid.Row="2" MinHeight="72" MaxHeight="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <DockPanel Grid.Row="3" Margin="0,8,0,0"><Button x:Name="SendButton" Content="发送" Click="Send_Click" DockPanel.Dock="Right" Margin="0" Background="#4768F5" Foreground="White"/><TextBlock Text="运行操作会记录在下方日志" FontSize="11" Foreground="#8A94A6" VerticalAlignment="Center"/></DockPanel>
                    </Grid></TabItem>
                </TabControl>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="White" CornerRadius="10" Margin="0,12,0,0" Padding="12,8">
            <TabControl BorderThickness="0"><TabItem Header="检测结果"><DataGrid x:Name="ResultGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="工具 / 指标" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="结果" Binding="{Binding Value}" Width="3*"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="运行日志"><TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></TabItem></TabControl>
        </Border>
        <DockPanel Grid.Row="3" Margin="3,10,3,0"><TextBlock x:Name="StatusText" Text="就绪" Foreground="#7E899D"/><TextBlock x:Name="ProjectInfo" HorizontalAlignment="Right" Foreground="#7E899D"/></DockPanel>
    </Grid>
</Window>
